# .env

# PostgreSQL (Chainlit History)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpass
POSTGRES_DB=chainlit_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (GPTCache Storage)
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector DB)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=my_documents

# vLLM (Inference)
# Ganti dengan URL vLLM service dalam docker network
VLLM_API_BASE=http://vllm:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# Embedding & Rerank Models (Download via HuggingFace di dalam container)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base